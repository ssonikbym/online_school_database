DESCRIBE teachers;
DESCRIBE enrollments;
DESCRIBE lessons;

-- 1. НЕЯВНОЕ СОЕДИНЕНИЕ ТАБЛИЦ С ФИЛЬТРОМ (WHERE) И СОРТИРОВКОЙ (ORDER BY)
-- ---------------------------------------------------------------------
 
-- 1.1 Журнал занятий за октябрь 2026: ученик, курс, тема (по дате и ФИО)
SELECT l.lesson_date AS 'Дата',
s.student_name AS 'Ученик',
c.course_name AS 'Курс',
l.topic AS 'Тема'
FROM lessons l, students s, courses c
WHERE l.student_id = s.student_id
AND l.course_id = c.course_id
AND l.lesson_date BETWEEN '2026-10-01' AND '2026-10-31'
ORDER BY l.lesson_date, s.student_name;
 
-- 1.2 Неоплаченные занятия со стоимостью с учётом скидки (по убыванию суммы)
SELECT s.student_name AS 'Ученик',
c.course_name AS 'Курс',
l.lesson_date AS 'Дата',
ROUND(c.price * (1 - e.discount / 100), 2) AS 'К оплате, руб.'
FROM lessons l, enrollments e, students s, courses c
WHERE l.student_id = e.student_id
AND l.course_id = e.course_id
AND e.student_id = s.student_id
AND e.course_id = c.course_id
AND l.paid = 0
ORDER BY 4 DESC, s.student_name;
  
-- ---------------------------------------------------------------------
-- 2. ЯВНОЕ СОЕДИНЕНИЕ ТАБЛИЦ (JOIN)
-- ---------------------------------------------------------------------
 
-- 2.1 INNER JOIN: кто на каком курсе учится и у какого преподавателя
SELECT s.student_name AS 'Ученик',
c.course_name AS 'Курс',
sb.subject_name AS 'Предмет',
t.teacher_name AS 'Преподаватель',
e.discount AS 'Скидка, %'
FROM enrollments e
INNER JOIN students s ON e.student_id = s.student_id
INNER JOIN courses c ON e.course_id = c.course_id
INNER JOIN subjects sb ON c.subject_code = sb.subject_code
INNER JOIN teachers t ON e.teacher_id = t.teacher_id
ORDER BY s.student_name;
  
-- 2.2 LEFT JOIN: ученики, которые ещё не зачислены ни на один курс
SELECT s.student_id, s.student_name, s.grade
FROM students s
LEFT JOIN enrollments e ON s.student_id = e.student_id
WHERE e.student_id IS NULL;
  
-- 2.3 LEFT JOIN: все курсы и количество учеников на них (включая пустые)
SELECT c.course_name AS 'Курс',
COUNT(e.student_id) AS 'Учеников'
FROM courses c
LEFT JOIN enrollments e ON c.course_id = e.course_id
GROUP BY c.course_id, c.course_name
ORDER BY 2 DESC;
  
-- 3. АГРЕГИРУЮЩИЕ ОПЕРАЦИИ (SUM, AVG, COUNT, MAX, MIN)
-- ---------------------------------------------------------------------
 
-- 3.1 Общая статистика журнала
SELECT COUNT(*) AS 'Всего записей',
SUM(attended) AS 'Посещено',
ROUND(AVG(hw_score), 1) AS 'Средний балл ДЗ',
MAX(hw_score) AS 'Максимальный балл',
MIN(hw_score) AS 'Минимальный балл'
FROM lessons;
  
-- 3.2 Самый дорогой и самый дешёвый курс, средняя стоимость занятия
SELECT MAX(price) AS 'Максимальная цена',
MIN(price) AS 'Минимальная цена',
ROUND(AVG(price), 2) AS 'Средняя цена'
FROM courses;
  
-- 3.3 Общая сумма задолженности по всем ученикам
SELECT ROUND(SUM(c.price * (1 - e.discount / 100)), 2) AS 'Общий долг, руб.'
FROM lessons l
JOIN enrollments e ON l.student_id = e.student_id AND l.course_id = e.course_id
JOIN courses c ON e.course_id = c.course_id
WHERE l.paid = 0;
  
-- ---------------------------------------------------------------------
-- 4. ГРУППИРОВКА (GROUP BY) И ФИЛЬТРАЦИЯ ГРУПП (HAVING)
-- ---------------------------------------------------------------------
 
-- 4.1 Задолженность по ученикам — только должники с долгом больше 1000 руб.
SELECT s.student_name AS 'Ученик',
COUNT(*) AS 'Неоплачено занятий',
ROUND(SUM(c.price * (1 - e.discount / 100)), 2) AS 'Долг, руб.'
FROM lessons l
JOIN enrollments e ON l.student_id = e.student_id AND l.course_id = e.course_id
JOIN students s ON e.student_id = s.student_id
JOIN courses c ON e.course_id = c.course_id
WHERE l.paid = 0
GROUP BY s.student_id, s.student_name
HAVING SUM(c.price * (1 - e.discount / 100)) > 1000
ORDER BY 3 DESC;
  
-- 4.2 Посещаемость и средний балл по ученикам (посещаемость ниже 100 %)
SELECT s.student_name AS 'Ученик',
COUNT(*) AS 'Занятий',
ROUND(100 * SUM(l.attended) / COUNT(*)) AS 'Посещаемость, %',
ROUND(AVG(l.hw_score), 1) AS 'Средний балл'
FROM lessons l
JOIN students s ON l.student_id = s.student_id
GROUP BY s.student_id, s.student_name
HAVING SUM(l.attended) < COUNT(*);
  
-- 4.3 Оплата преподавателям: число проведённых занятий × ставка
-- (групповое занятие считается один раз)
SELECT t.teacher_name AS 'Преподаватель',
COUNT(DISTINCT l.course_id, l.lesson_date) AS 'Проведено занятий',
t.rate AS 'Ставка',
COUNT(DISTINCT l.course_id, l.lesson_date) * t.rate AS 'К выплате, руб.'
FROM lessons l
JOIN enrollments e ON l.student_id = e.student_id AND l.course_id = e.course_id
JOIN teachers t ON e.teacher_id = t.teacher_id
GROUP BY t.teacher_id, t.teacher_name, t.rate
HAVING COUNT(DISTINCT l.course_id, l.lesson_date) >= 1
ORDER BY 4 DESC;
  
-- 4.4 Средний балл по курсам — курсы со средним баллом выше 70
SELECT c.course_name AS 'Курс',
COUNT(l.hw_score) AS 'Оценённых ДЗ',
ROUND(AVG(l.hw_score), 1) AS 'Средний балл'
FROM lessons l
JOIN courses c ON l.course_id = c.course_id
GROUP BY c.course_id, c.course_name
HAVING AVG(l.hw_score) > 70
ORDER BY 3 DESC;
