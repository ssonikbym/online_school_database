-- 1. СОЗДАНИЕ БАЗЫ ДАННЫХ ------------------------------------------------
DROP DATABASE IF EXISTS online_school;
CREATE DATABASE online_school
CHARACTER SET utf8mb4
COLLATE utf8mb4_unicode_ci;
 
USE online_school;
 
-- 2. СОЗДАНИЕ ТАБЛИЦ И СВЯЗЕЙ --------------------------------------------
-- Сначала родительские таблицы, затем дочерние
 
CREATE TABLE subjects (
subject_code CHAR(2) NOT NULL,
subject_name VARCHAR(50) NOT NULL,
PRIMARY KEY (subject_code),
UNIQUE (subject_name)
) ENGINE = InnoDB;
 
CREATE TABLE courses (
course_id INT NOT NULL AUTO_INCREMENT,
course_name VARCHAR(100) NOT NULL,
subject_code CHAR(2) NOT NULL,
price DECIMAL(8,2) NOT NULL,
PRIMARY KEY (course_id),
CONSTRAINT fk_courses_subjects FOREIGN KEY (subject_code)
REFERENCES subjects (subject_code)
ON UPDATE CASCADE ON DELETE RESTRICT,
CONSTRAINT chk_courses_price CHECK (price > 0)
) ENGINE = InnoDB;
 
CREATE TABLE students (
student_id INT NOT NULL AUTO_INCREMENT,
student_name VARCHAR(100) NOT NULL,
grade TINYINT NOT NULL,
parent_phone CHAR(18) NOT NULL,
PRIMARY KEY (student_id),
CONSTRAINT chk_students_grade CHECK (grade BETWEEN 1 AND 11)
) ENGINE = InnoDB;
 
CREATE TABLE teachers (
teacher_id INT NOT NULL AUTO_INCREMENT,
teacher_name VARCHAR(100) NOT NULL,
rate DECIMAL(8,2) NOT NULL,
PRIMARY KEY (teacher_id),
CONSTRAINT chk_teachers_rate CHECK (rate > 0)
) ENGINE = InnoDB;
 
CREATE TABLE enrollments (
student_id INT NOT NULL,
course_id INT NOT NULL,
teacher_id INT NOT NULL,
discount TINYINT NOT NULL DEFAULT 0,
PRIMARY KEY (student_id, course_id),
CONSTRAINT fk_enr_students FOREIGN KEY (student_id)
REFERENCES students (student_id) ON UPDATE CASCADE ON DELETE RESTRICT,
CONSTRAINT fk_enr_courses FOREIGN KEY (course_id)
REFERENCES courses (course_id) ON UPDATE CASCADE ON DELETE RESTRICT,
CONSTRAINT fk_enr_teachers FOREIGN KEY (teacher_id)
REFERENCES teachers (teacher_id) ON UPDATE CASCADE ON DELETE RESTRICT,
CONSTRAINT chk_enr_discount CHECK (discount BETWEEN 0 AND 50)
) ENGINE = InnoDB;
 
CREATE TABLE lessons (
student_id INT NOT NULL,
course_id INT NOT NULL,
lesson_date DATE NOT NULL,
topic VARCHAR(150) NOT NULL,
attended BOOLEAN NOT NULL DEFAULT 1,
hw_score TINYINT NULL,
paid BOOLEAN NOT NULL DEFAULT 0,
PRIMARY KEY (student_id, course_id, lesson_date),
CONSTRAINT fk_lessons_enrollments FOREIGN KEY (student_id, course_id)
REFERENCES enrollments (student_id, course_id)
ON UPDATE CASCADE ON DELETE CASCADE,
CONSTRAINT chk_lessons_score CHECK (hw_score BETWEEN 0 AND 100)
) ENGINE = InnoDB;
 
-- 3. ИЗМЕНЕНИЕ СТРУКТУРЫ ТАБЛИЦ (ALTER TABLE) -----------------------------
-- 3.1 Добавляем поле e-mail родителя (необязательное)
ALTER TABLE students ADD COLUMN parent_email VARCHAR(100) NULL AFTER parent_phone;
 
-- 3.2 Увеличиваем длину названия курса
ALTER TABLE courses MODIFY COLUMN course_name VARCHAR(120) NOT NULL;
 
-- 3.3 Добавляем ограничение уникальности названия курса
ALTER TABLE courses ADD CONSTRAINT uq_courses_name UNIQUE (course_name);
 
-- 3.4 Добавляем индекс для быстрого поиска занятий по дате
ALTER TABLE lessons ADD INDEX idx_lessons_date (lesson_date);
 
